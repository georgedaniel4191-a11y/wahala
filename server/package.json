{
  "name": "@wahala/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run generate:case && tsc -p tsconfig.json",
    "typecheck": "npm run generate:case && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "generate:case": "node scripts/generate-case-types.cjs"
  },
  "dependencies": {
    "@wahala/shared": "*",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
